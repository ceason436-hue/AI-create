# Production platform template. Inject real values through the deployment
# platform or a managed secret store; never commit them to the repository.
DATABASE_URL=
REDIS_URL=
NEXT_PUBLIC_SITE_URL=https://lingpeak.com

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com

STORAGE_DRIVER=OSS
LOCAL_STORAGE_PATH=./.data/works
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# Safe launch default. Enable only after credit weights, provider responses,
# concurrency and failure recovery have passed staging acceptance.
AI_GENERATION_ENABLED=false
AI_CONCURRENCY_PER_ACCOUNT=2
AI_REQUESTS_PER_MINUTE=10
AI_TRIAL_TIMEZONE=Asia/Shanghai
KRT_AI_REQUEST_TIMEOUT_MINUTES=15
KRT_AI_REQUEST_RECOVERY_BATCH_SIZE=100

COURSEWARE_WORKER_TOKEN=
COURSEWARE_UPLOAD_MAX_BYTES=209715200
COURSEWARE_CONVERSION_TIMEOUT_MS=120000
SOFFICE_PATH=

MEDIA_WORKER_TOKEN=
MEDIA_VIDEO_UPLOAD_MAX_BYTES=209715200
MEDIA_PROCESSING_TIMEOUT_MS=600000
FFMPEG_PATH=

# One-time administration commands only. Leave empty during normal runtime.
KRT_BOOTSTRAP_ADMIN_CONFIRMATION=
KRT_BOOTSTRAP_ADMIN_LOGIN=
KRT_BOOTSTRAP_ADMIN_PASSWORD=
KRT_ADMIN_PASSWORD_RESET_CONFIRMATION=
KRT_ADMIN_PASSWORD_RESET_LOGIN=
KRT_ADMIN_PASSWORD_RESET_VALUE=
