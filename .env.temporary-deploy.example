# Temporary deployment: no database, Redis, or OSS.
# This must only be used for the time-limited fallback release.
KRT_TEMPORARY_DEPLOYMENT=true
AI_GENERATION_ENABLED=true
# Development preview only. Leave false (or unset) behind HTTPS on the server.
KRT_TEMPORARY_ALLOW_INSECURE_HTTP=false

# Required for the four AI tools. Set the real value only in the server's
# private environment file; never commit it or put it in a deployment archive.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MUSIC_MODEL=music-2.6

NEXT_PUBLIC_SITE_URL=https://lingpeak.com
STORAGE_DRIVER=LOCAL
