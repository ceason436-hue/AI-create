{
  "name": "krt-ai",
  "version": "0.1.0",
  "private": true,
  "description": "科瑞特 AI 创造平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:serve": "node scripts/start-e2e-standalone.mjs",
    "routes:inventory": "node scripts/check-route-contract.mjs --stdout",
    "routes:check": "node scripts/check-route-contract.mjs --check",
    "fixtures:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-acceptance-fixtures.ps1",
    "fixtures:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-acceptance-fixtures.ps1 -Mode clean",
    "acceptance:data:seed": "node scripts/acceptance-data.mjs seed",
    "acceptance:data:clean": "node scripts/acceptance-data.mjs clean",
    "security:scan": "node scripts/check-no-secrets.mjs",
    "admin:init": "node scripts/initialize-super-admin.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "works:retention": "node scripts/run-retention-jobs.mjs",
    "ai:recover": "node scripts/release-stale-ai-requests.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^2.4.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "16.3.4",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^4.7.1",
    "tone": "^15.1.22",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
